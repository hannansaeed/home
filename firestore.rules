rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() <= 200 &&
             (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidChat(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.participantIds is list && data.participantIds.size() >= 1 && data.participantIds.size() <= 10 &&
             (data.participantIds.size() == 0 || data.participantIds[0] is string) &&
             request.auth.uid in data.participantIds &&
             data.lastMessage is string && data.lastMessage.size() <= 5000 &&
             (!('lastMessageSenderId' in data) || data.lastMessageSenderId == null || (data.lastMessageSenderId is string && data.lastMessageSenderId.size() <= 128)) &&
             (!('lastMessageSenderName' in data) || data.lastMessageSenderName == null || (data.lastMessageSenderName is string && data.lastMessageSenderName.size() <= 100)) &&
             (!('participantNames' in data) || data.participantNames is map) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidMessage(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.chatId is string && data.chatId.size() > 0 && data.chatId.size() <= 128 &&
             data.senderId is string && data.senderId == request.auth.uid &&
             data.senderName is string && data.senderName.size() > 0 && data.senderName.size() <= 100 &&
             data.text is string && data.text.size() > 0 && data.text.size() <= 5000 &&
             data.participantIds is list && data.participantIds.size() >= 1 && data.participantIds.size() <= 10 &&
             request.auth.uid in data.participantIds &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUser(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && isValidId(userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUser(incoming());
      allow delete: if false;
    }

    match /chats/{chatId} {
      allow get: if isSignedIn() && isValidId(chatId) && request.auth.uid in resource.data.participantIds;
      allow list: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn() && isValidId(chatId) &&
                       request.auth.uid in incoming().participantIds &&
                       incoming().id == chatId &&
                       isValidChat(incoming());
      allow update: if isSignedIn() && isValidId(chatId) &&
                       request.auth.uid in existing().participantIds &&
                       request.auth.uid in incoming().participantIds &&
                       incoming().id == existing().id &&
                       incoming().createdAt == existing().createdAt &&
                       isValidChat(incoming());
      allow delete: if false;

      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(messageId) && request.auth.uid in resource.data.participantIds;
        allow list: if isSignedIn() && request.auth.uid in resource.data.participantIds;
        allow create: if isSignedIn() && isValidId(messageId) &&
                         incoming().id == messageId &&
                         incoming().chatId == chatId &&
                         incoming().senderId == request.auth.uid &&
                         request.auth.uid in incoming().participantIds &&
                         isValidMessage(incoming());
        allow update: if isSignedIn() && isValidId(messageId) &&
                         existing().senderId == request.auth.uid &&
                         incoming().id == existing().id &&
                         incoming().chatId == existing().chatId &&
                         incoming().senderId == existing().senderId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidMessage(incoming());
        allow delete: if isSignedIn() && isValidId(messageId) && existing().senderId == request.auth.uid;
      }
    }
  }
}
